use std::string::format;

mod math;
mod ray;

use math::*;

type Color = math::Vec3;

fn main() {
    var width = 256;
    var height = 256;

    var output = format("P3\n{} {}\n255\n", [width.to_str(), height.to_str()]);
    var time = std::duration::Duration::now();

    for j in 0..height {
        println(format("Scanlines remaining {}/{}", [j.to_str(), height.to_str()]));
        for i in 0..width {
            var r = i as float / width as float;
            var g = j as float / height as float;
            var b = 0.0;

            var color = Color::new(r, g, b);
            write_color(&output, color);

        }
    }


    println(time.elapsed());
    var write_time = std::duration::Duration::now();
    std::io::write_file("out.ppm", output.as_bytes());
    println(write_time.elapsed());
}


fn write_color(&output: str, color: Color) {
    var ir = (color.x * 255.999) as int;
    var ig = (color.y * 255.999) as int;
    var ib = (color.z * 255.999) as int;

    output = output.concat(format(
        "{} {} {}\n", 
        [ir.to_str(), ig.to_str(), ib.to_str()]
    ))
}

