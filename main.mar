mod math;
mod ray;
mod sphere;
mod hittable_list;
mod hittable;
mod interval;
mod material;
mod camera;

use math::*;
use sphere::*;
use hittable_list::*;
use hittable::*;
use camera::*;

use material::*;
type Color = math::Vec3;

fn main() {
    let ground_material = Material::Lambertian(Vec3::new(0.8, 0.8, 0.0));
    let center_material = Material::Lambertian(Vec3::new(0.1, 0.2, 0.5));
    let left_material = Material::Dielectric(1.5);
    let right_material = Material::Metal(MetalMaterial {
        albedo: Vec3::new(0.8, 0.6, 0.2),
        fuzz: 1.0,
    });

    let world = HittableList::new()
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(0.0, -100.5, -1.0),
            100.0,
            ground_material
        )))
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(0.0, 0.0, -1.2),
            0.5,
            center_material
        )))
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(-1.0, 0.0, -1.0),
            0.5,
            left_material
        )))
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(1.0, 0.0, -1.0),
            0.5,
            right_material
        )));

    var camera = Camera::new();
    camera.aspect_ratio = 16.0 / 9.0;
    camera.image_width = 400;
    camera.samples_per_pixel = 100;
    camera.max_depth = 50;
    camera.render(world);
}
