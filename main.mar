mod math;
mod ray;
mod sphere;
mod hittable_list;
mod hittable;
mod interval;
mod material;
mod camera;

use math::*;
use sphere::*;
use hittable_list::*;
use hittable::*;
use camera::*;

use material::*;
type Color = math::Vec3;

fn main() {
    let radius = 0.7071067811865475;
    let left_material = Material::Lambertian(Vec3::new(0.0, 0.0, 1.0));
    let right_material = Material::Lambertian(Vec3::new(1.0, 0.0, 0.0));

    let world = HittableList::new()
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(-radius, 0.0, -1.0),
            radius,
            left_material
        )))
        .add(Hittable::Sphere(Sphere::new(
            Vec3::new(radius, 0.0, -1.0),
            radius,
            right_material
        )));

    var camera = Camera::new();
    camera.aspect_ratio = 16.0 / 9.0;
    camera.image_width = 400;
    camera.samples_per_pixel = 100;
    camera.max_depth = 50;
    camera.vfov = 90.0;
    camera.render(world);

}
