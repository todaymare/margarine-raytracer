mod math;
mod ray;
mod sphere;
mod hittable_list;
mod hittable;
mod interval;
mod camera;

use math::*;
use sphere::*;
use hittable_list::*;
use hittable::*;
use camera::*;

type Color = math::Vec3;

fn main() {
    let world = HittableList::new()
        .add(Hittable::Sphere(Sphere::new(Vec3::new(0.0, 0.0, -1.0), 0.5)))
        .add(Hittable::Sphere(Sphere::new(Vec3::new(0.0, -100.5, -1.0), 100.0)));

    var camera = Camera::new();
    camera.aspect_ratio = 16.0 / 9.0;
    camera.image_width = 400;
    camera.render(world);
}
