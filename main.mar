use std::string::format;

mod math;
mod ray;

use math::*;

type Color = math::Vec3;

fn main() {
    var time = std::duration::Duration::now();

    var aspect_ratio = 16.0 / 9.0;
    var image_width = 400;
    var image_height = (image_width as float / aspect_ratio) as int;
    var image_height = image_height.max(1);

    var viewport_height = 2.0;
    var viewport_width = viewport_height * (image_width as float / image_height as float);

    var output = format("P3\n{} {}\n255\n", [image_width.to_str(), image_height.to_str()]);


    for j in 0..image_height {
        println(format("Scanlines remaining {}/{}", [j.to_str(), image_height.to_str()]));
        for i in 0..image_width {
            var r = i as float / image_width as float;
            var g = j as float / image_height as float;
            var b = 0.0;

            var color = Color::new(r, g, b);
            write_color(&output, color);

        }
    }


    println(time.elapsed());
    var write_time = std::duration::Duration::now();
    std::io::write_file("out.ppm", output.as_bytes());
    println(write_time.elapsed());
}


fn write_color(&output: str, color: Color) {
    var ir = (color.x * 255.999) as int;
    var ig = (color.y * 255.999) as int;
    var ib = (color.z * 255.999) as int;

    output = output.concat(format(
        "{} {} {}\n", 
        [ir.to_str(), ig.to_str(), ib.to_str()]
    ))
}

