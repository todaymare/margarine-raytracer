use std::rand::random;

pub struct Vec3 {
    x: float,
    y: float,
    z: float,
}


impl Vec3 {
    fn new(x: float, y: float, z: float): Self {
        Self { x, y, z }
    }

    fn with_x(x: float): Self { Self::new(x, 0.0, 0.0) }
    fn with_y(y: float): Self { Self::new(0.0, y, 0.0) }
    fn with_z(z: float): Self { Self::new(0.0, 0.0, z) }

    fn splat(value: float): Self {
        Self::new(value, value, value)
    }

    fn neg(self): Vec3 {
        Self::new(-self.x, -self.y, -self.z)
    }

    fn length_squared(self): float {
        self.x*self.x + self.y*self.y + self.z*self.z
    }

    fn length(self): float {
        self.length_squared().sqrt()
    }

    fn add(self, b: Vec3): Vec3 {
        Self::new(self.x+b.x, self.y+b.y, self.z+b.z)
    }

    fn sub(self, b: Vec3): Vec3 {
        Self::new(self.x-b.x, self.y-b.y, self.z-b.z)
    }

    fn mul(self, b: Vec3): Vec3 {
        Self::new(self.x*b.x, self.y*b.y, self.z*b.z)
    }

    fn scale(self, b: float): Vec3 { self.mul(Self::splat(b)) }

    fn random(): Self {
        Self::new(random::<float>(), random::<float>(), random::<float>())
    }

    fn random_range(min: float, max: float): Self {
        Self::new(
            min + (max - min) * random::<float>(),
            min + (max - min) * random::<float>(),
            min + (max - min) * random::<float>()
        )
    }

    fn random_unit_vector(): Self {
        loop {
            let p = Self::random_range(-1.0, 1.0);
            let length_squared = p.length_squared();
            if 1e-160 < length_squared && length_squared <= 1.0 {
                return p.scale(1.0 / length_squared.sqrt());
            }
        }
    }

    fn random_on_hemisphere(normal: Vec3): Self {
        let on_unit_sphere = Self::random_unit_vector();
        if on_unit_sphere.dot(normal) > 0.0 {
            on_unit_sphere
        } else {
            on_unit_sphere.neg()
        }
    }

    fn div(self, b: Vec3): Vec3 {
        Self::new(self.x * 1.0 / b.x, self.y * (1.0 / b.y), self.z * (1.0 / b.z))
    }

    fn dot(self, other: Vec3): float {
        self.x * other.x + self.y * other.y + self.z * other.z
    }
    
    fn cross(self, v: Vec3): Self {
        let u = self;
        Self::new(u.y * v.z - u.z * v.y,
                  u.z * v.x - u.x * v.z,
                  u.x * v.y - u.y * v.x
        )
    }

    fn unit(self): Self {
        self.div(Self::splat(self.length()))
    }
}
