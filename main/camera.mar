use std::string::format;
use std::string::ToStr;
use std::rand::random;
use root::math::Vec3;
use root::ray::Ray;
use root::hittable_list::HittableList;
use root::interval::Interval;
use root::Color;

pub struct Camera {
    aspect_ratio: float,
    image_width: int,
    samples_per_pixel: int,
    max_depth: int,
}

impl Camera {
    pub fn new(): Self {
        Self { aspect_ratio: 1.0, image_width: 100, samples_per_pixel: 10, max_depth: 10 }
    }

    pub fn render(self, world: HittableList) {
        let time = std::duration::Duration::now();

        let image_height = (self.image_width as float / self.aspect_ratio) as int;
        let image_height = image_height.max(1);

        let focal_length = 1.0;
        let viewport_height = 2.0;
        let viewport_width = viewport_height
            * (self.image_width as float / image_height as float);
        let camera_center = Vec3::new(0.0, 0.0, 0.0);

        let viewport_u = Vec3::with_x(viewport_width);
        let viewport_v = Vec3::with_y(-viewport_height);

        let pixel_delta_u = viewport_u.scale(1.0 / self.image_width as float);
        let pixel_delta_v = viewport_v.scale(1.0 / image_height as float);

        let viewport_upper_left = camera_center
            .sub(Vec3::with_z(focal_length))
            .sub(viewport_u.scale(0.5))
            .sub(viewport_v.scale(0.5));

        let pixel_delta_center = pixel_delta_u
            .add(pixel_delta_v)
            .scale(0.5);
        let pixel00_loc = viewport_upper_left
            .add(pixel_delta_center);

        var output = format(
            "P3\n{} {}\n255\n",
            [self.image_width.to_str(), image_height.to_str()]
        );

        for j in 0..image_height {
            println(format("Scanlines remaining: {}", [(image_height - j).to_str()]));

            for i in 0..self.image_width {
                var pixel_color = Color::splat(0.0);
                for sample in 0..self.samples_per_pixel {
                    let ray = self.get_ray(
                        i,
                        j,
                        pixel00_loc,
                        pixel_delta_u,
                        pixel_delta_v,
                        camera_center
                    );
                    pixel_color = pixel_color.add(ray.color(world, self.max_depth));
                }
                write_color(
                    &output,
                    pixel_color.scale(1.0 / self.samples_per_pixel as float)
                );
            }
        }

        println(time.elapsed());
        let write_time = std::duration::Duration::now();
        std::io::write_file("out.ppm", output.as_bytes());
        println(write_time.elapsed());
    }

    fn get_ray(
        self,
        i: int,
        j: int,
        pixel00_loc: Vec3,
        pixel_delta_u: Vec3,
        pixel_delta_v: Vec3,
        camera_center: Vec3
    ): Ray {
        let offset = self.sample_square();
        let pixel_sample = pixel00_loc
            .add(pixel_delta_u.scale(i as float + offset.x))
            .add(pixel_delta_v.scale(j as float + offset.y));
        Ray::new(camera_center, pixel_sample.sub(camera_center))
    }

    fn sample_square(self): Vec3 {
        Vec3::new(random::<float>() - 0.5, random::<float>() - 0.5, 0.0)
    }
}

fn write_color(&output: str, color: Color) {
    let intensity = Interval::new(0.0, 0.999);
    let ir = (intensity.clamp(color.x) * 256.0) as int;
    let ig = (intensity.clamp(color.y) * 256.0) as int;
    let ib = (intensity.clamp(color.z) * 256.0) as int;

    output = output.concat(format(
        "{} {} {}\n",
        [ir.to_str(), ig.to_str(), ib.to_str()]
    ))
}
