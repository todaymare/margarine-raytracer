use std::string::format;
use std::string::ToStr;
use std::rand::Rng;
use std::rand::Xoshiro256;
use root::math::Vec3;
use root::ray::Ray;
use root::hittable_list::HittableList;
use root::interval::Interval;
use root::Color;

pub struct Camera {
    aspect_ratio: float,
    image_width: int,
    samples_per_pixel: int,
    max_depth: int,
    vfov: float,
    lookfrom: Vec3,
    lookat: Vec3,
    vup: Vec3,
    defocus_angle: float,
    focus_dist: float,
}

impl Camera {
    pub fn new(): Self {
        Self {
            aspect_ratio: 1.0,
            image_width: 100,
            samples_per_pixel: 10,
            max_depth: 10,
            vfov: 90.0,
            lookfrom: Vec3::new(0.0, 0.0, 0.0),
            lookat: Vec3::new(0.0, 0.0, -1.0),
            vup: Vec3::new(0.0, 1.0, 0.0),
            defocus_angle: 0.0,
            focus_dist: 10.0
        }
    }

    pub fn render(self, world: HittableList) {
        let time = std::duration::Duration::now();
        var rng = Rng::new(Xoshiro256::from_seed((1, 2, 3, 4)));

        let image_height = (self.image_width as float / self.aspect_ratio) as int;
        let image_height = image_height.max(1);

        let focal_length = self.focus_dist;
        let theta = self.vfov * 3.141592653589793 / 180.0;
        let h = tan(theta * 0.5);
        let viewport_height = 2.0 * h * focal_length;
        let viewport_width = viewport_height
            * (self.image_width as float / image_height as float);
        let camera_center = self.lookfrom;

        let w = self.lookfrom.sub(self.lookat).unit();
        let u = self.vup.cross(w).unit();
        let v = w.cross(u);
        let viewport_u = u.scale(viewport_width);
        let viewport_v = v.scale(-viewport_height);
        let defocus_radius = self.focus_dist
            * tan(self.defocus_angle * 3.141592653589793 / 360.0);
        let defocus_disk_u = u.scale(defocus_radius);
        let defocus_disk_v = v.scale(defocus_radius);

        let pixel_delta_u = viewport_u.scale(1.0 / self.image_width as float);
        let pixel_delta_v = viewport_v.scale(1.0 / image_height as float);

        let viewport_upper_left = camera_center
            .sub(w.scale(focal_length))
            .sub(viewport_u.scale(0.5))
            .sub(viewport_v.scale(0.5));

        let pixel_delta_center = pixel_delta_u
            .add(pixel_delta_v)
            .scale(0.5);
        let pixel00_loc = viewport_upper_left
            .add(pixel_delta_center);

        var output = format(
            "P3\n{} {}\n255\n",
            [self.image_width.to_str(), image_height.to_str()]
        );

        for j in 0..image_height {
            println(format("Scanlines remaining: {}", [(image_height - j).to_str()]));

            for i in 0..self.image_width {
                var pixel_color = Color::splat(0.0);
                for sample in 0..self.samples_per_pixel {
                    let ray = self.get_ray(
                        i,
                        j,
                        defocus_disk_u,
                        defocus_disk_v,
                        pixel00_loc,
                        pixel_delta_u,
                        pixel_delta_v,
                        camera_center,
                        &rng
                    );
                    pixel_color = pixel_color.add(ray.color(world, self.max_depth, &rng));
                }
                write_color(
                    &output,
                    pixel_color.scale(1.0 / self.samples_per_pixel as float)
                );
            }
        }

        println(time.elapsed());
        let write_time = std::duration::Duration::now();
        std::io::write_file("out.ppm", output.as_bytes());
        println(write_time.elapsed());
    }

    fn get_ray(
        self,
        i: int,
        j: int,
        defocus_disk_u: Vec3,
        defocus_disk_v: Vec3,
        pixel00_loc: Vec3,
        pixel_delta_u: Vec3,
        pixel_delta_v: Vec3,
        camera_center: Vec3,
        &rng: Rng<Xoshiro256>
    ): Ray {
        let offset = self.sample_square(&rng);
        let pixel_sample = pixel00_loc
            .add(pixel_delta_u.scale(i as float + offset.x))
            .add(pixel_delta_v.scale(j as float + offset.y));
        let disk_sample = self.random_in_unit_disk(&rng);
        let ray_origin = if self.defocus_angle <= 0.0 {
            camera_center
        } else {
            camera_center
                .add(defocus_disk_u.scale(disk_sample.x))
                .add(defocus_disk_v.scale(disk_sample.y))
        };
        Ray::new(ray_origin, pixel_sample.sub(ray_origin))
    }

    fn random_in_unit_disk(self, &rng: Rng<Xoshiro256>): Vec3 {
        let p = Vec3::new(
            rng.random::<float>() * 2.0 - 1.0,
            rng.random::<float>() * 2.0 - 1.0,
            0.0
        );
        if p.length_squared() < 1.0 {
            p
        } else {
            p.scale(0.7071067811865475)
        }
    }

    fn sample_square(self, &rng: Rng<Xoshiro256>): Vec3 {
        Vec3::new(rng.random::<float>() - 0.5, rng.random::<float>() - 0.5, 0.0)
    }
}

fn linear_to_gamma(value: float): float {
    if value > 0.0 {
        value.sqrt()
    } else {
        0.0
    }
}

fn write_color(&output: str, color: Color) {
    let r = linear_to_gamma(color.x);
    let g = linear_to_gamma(color.y);
    let b = linear_to_gamma(color.z);
    let intensity = Interval::new(0.0, 0.999);
    let ir = (intensity.clamp(r) * 256.0) as int;
    let ig = (intensity.clamp(g) * 256.0) as int;
    let ib = (intensity.clamp(b) * 256.0) as int;

    output = output.concat(format(
        "{} {} {}\n",
        [ir.to_str(), ig.to_str(), ib.to_str()]
    ))
}

fn tan(value: float): float {
    let squared = value * value;
    value * (15.0 - squared) / (15.0 - 6.0 * squared)
}
