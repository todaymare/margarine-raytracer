use root::math::Vec3;
use root::ray::Ray;
use root::sphere::Sphere;
use root::hittable_list::HittableList;
use root::interval::Interval;
use root::material::Material;

pub struct HitRecord {
    p: Vec3,
    normal: Vec3,
    t: float,
    front_face: bool,
    material: Material,
}

impl HitRecord {
    pub fn set_face_normal(self, r: Ray, outward_normal: Vec3): HitRecord {
        let front_face = r.dir.dot(outward_normal) < 0.0;
        HitRecord {
            p: self.p,
            normal: if front_face { outward_normal } else { outward_normal.neg() },
            t: self.t,
            front_face: front_face,
            material: self.material,
        }
    }
}

pub enum Hittable {
    Sphere(Sphere),
    List(HittableList),
}

impl Hittable {
    pub fn hit(self, r: Ray, ray_t: Interval): Option<HitRecord> {
        match self {
            Sphere(s) => s.hit(r, ray_t),
            List(l) => l.hit(r, ray_t),
        }
    }
}
