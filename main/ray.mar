use std::rand::Rng;
use std::rand::Xoshiro256;
use root::math::Vec3;
use root::hittable_list::HittableList;
use root::interval::Interval;
use root::material::Material;
use root::Color;

pub struct Ray {
    ori: Vec3,
    dir: Vec3,
}


impl Ray {
    fn new(ori: Vec3, dir: Vec3): Self { Self { ori, dir } }
    fn at(self, t: float): Vec3 { self.ori.add(self.dir.mul(Vec3::splat(t))) }

    fn color(self, world: HittableList, depth: int, &rng: Rng<Xoshiro256>): Color {
        if depth <= 0 {
            return Color::splat(0.0);
        }

        match world.hit(self, Interval::new(0.001, 1.0 / 0.0)) {
            some(rec) => match rec.material {
                Lambertian(albedo) => {
                    let direction = rec.normal.add(Vec3::random_unit_vector(&rng));
                    Ray::new(rec.p, direction)
                        .color(world, depth - 1, &rng)
                        .mul(albedo)
                },
                Metal(metal) => {
                    let reflected = self.dir.reflect(rec.normal).unit()
                        .add(Vec3::random_unit_vector(&rng).scale(metal.fuzz));
                    if reflected.dot(rec.normal) > 0.0 {
                        Ray::new(rec.p, reflected)
                            .color(world, depth - 1, &rng)
                            .mul(metal.albedo)
                    } else {
                        Color::splat(0.0)
                    }
                },
                Dielectric(refraction_index) => {
                    let ri = if rec.front_face {
                        1.0 / refraction_index
                    } else {
                        refraction_index
                    };
                    let unit_direction = self.dir.unit();
                    let cos_theta = -unit_direction.dot(rec.normal);
                    let sin_theta = (1.0 - cos_theta * cos_theta).sqrt();
                    let cannot_refract = ri * sin_theta > 1.0;
                    let direction = if cannot_refract
                        || reflectance(cos_theta, ri) > rng.random::<float>() {
                        unit_direction.reflect(rec.normal)
                    } else {
                        unit_direction.refract(rec.normal, ri)
                    };
                    Ray::new(rec.p, direction)
                        .color(world, depth - 1, &rng)
                },
            },
            none => {
                let unit_direction = self.dir.unit();
                let a = 0.5 * (unit_direction.y + 1.0);
                let white = Color::new(1.0, 1.0, 1.0);
                let blue = Color::new(0.5, 0.7, 1.0);

                white.scale(1.0 - a)
                    .add(blue.scale(a))
            }
        }
    }


}


fn reflectance(cosine: float, refraction_index: float): float {
    let r0 = (1.0 - refraction_index) / (1.0 + refraction_index);
    let r0 = r0 * r0;
    let one_minus_cosine = 1.0 - cosine;
    r0 + (1.0 - r0)
        * one_minus_cosine
        * one_minus_cosine
        * one_minus_cosine
        * one_minus_cosine
        * one_minus_cosine
}